{
  "manifest_version": 3,
  "name": "Lowery",
  "version": "1.0.0",
  "description": "Block images and videos using smart URL patterns.",
  "icons": {
    "16": "icons/katakito.png",
    "48": "icons/katakito.png",
    "128": "icons/katakito.png"
  },
  "action": {
    "default_title": "Lowery",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/katakito.png",
      "32": "icons/katakito.png",
      "48": "icons/katakito.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
